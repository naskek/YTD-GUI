{
  "name": "Mini URL Converter YouTube Auth Bridge",
  "description": "Lets Mini URL Converter request YouTube/Google cookies directly from Chrome for yt-dlp authentication.",
  "version": "1.0.0",
  "manifest_version": 3,
  "key": "",
  "permissions": ["cookies", "nativeMessaging"],
  "host_permissions": [
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://google.com/*",
    "https://*.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
